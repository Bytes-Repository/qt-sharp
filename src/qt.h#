;; Same archiwum `libqthsharp.a` nie ma żadnych zależności Qt zapisanych
;; jako `-l...` (to statyczna biblioteka .a, nie .so z wpisanym DT_NEEDED),
;; więc program końcowy sam musi dociągnąć Qt6 + libstdc++ przy
;; linkowaniu. Ten blok nie deklaruje żadnych funkcji — służy wyłącznie
;; do wstrzyknięcia flag linkera (`pkg-config --libs Qt6Widgets`, co samo
;; w sobie ciągnie Qt6Core/Qt6Gui przez `Requires:` w plikach .pc, plus
;; automatyczne `-lstdc++` doklejane przez H# dla każdego bloku `[c++]`).
extern dynamic [c++, "Qt6Widgets"] is
end

;; ── Typy wysokiego poziomu ───────────────────────────────────────────

;; Uchwyt do dowolnego widgetu Qt (QWidget i pochodne: okno, przycisk,
;; etykieta, pole tekstowe, checkbox, suwak, kontener).
struct Widget is
    pub handle: int
end

;; Uchwyt do layoutu Qt (QVBoxLayout / QHBoxLayout).
struct Layout is
    pub handle: int
end

enum EventKind is
    Clicked
    TextChanged
    ReturnPressed
    Toggled
    WindowClosed
    ValueChanged
    Unknown
end

struct Event is
    pub kind:   EventKind
    pub widget: Widget
end

fn event_kind_from_i32(k: i32) -> EventKind is
    match k is
        1 => is return EventKind::Clicked end
        2 => is return EventKind::TextChanged end
        3 => is return EventKind::ReturnPressed end
        4 => is return EventKind::Toggled end
        5 => is return EventKind::WindowClosed end
        6 => is return EventKind::ValueChanged end
        _ => is return EventKind::Unknown end
    end
end

;; ── Aplikacja ────────────────────────────────────────────────────────

;; Inicjalizuje `QApplication` (jednorazowo — kolejne wywołania są
;; bezpieczne i nic nie robią). Wywołaj to jako pierwszą rzecz w `main()`.
pub fn init() is
    qth_app_init()
end

;; Uruchamia natywną, blokującą pętlę zdarzeń Qt (`QApplication::exec()`).
;; Użyj tego zamiast ręcznej pętli `poll_event()`, jeśli Twoja aplikacja
;; nie potrzebuje nic robić poza reagowaniem na zdarzenia GUI — w takim
;; wypadku podłącz logikę pod widgety *przed* wywołaniem `run()` i
;; sprawdzaj zdarzenia w osobnym wątku/timerze (poza zakresem tej wersji
;; biblioteki) albo po prostu użyj pętli `poll_event()` poniżej, która
;; działa świetnie dla zwykłych, jednowątkowych aplikacji H#.
pub fn run() -> int is
    return qth_app_exec()
end

;; Kończy pętlę zdarzeń uruchomioną przez `run()`.
pub fn quit() is
    qth_app_quit()
end

;; Przetwarza oczekujące zdarzenia Qt bez blokowania — wywołuj to w
;; każdej iteracji własnej pętli głównej przed `poll_event()`.
pub fn process_events() is
    qth_app_process_events()
end

;; Czy aplikacja wciąż działa (nikt nie wywołał jeszcze `quit()`).
pub fn is_running() -> bool is
    return qth_app_is_running() != 0
end

pub fn set_style(style_name: string) is
    qth_app_set_style(style_name)
end

pub fn set_app_name(name: string) is
    qth_app_set_app_name(name)
end

;; Odbiera pojedyncze zdarzenie z kolejki, jeśli jakieś czeka (albo `nil`,
;; gdy kolejka jest pusta). Typowe użycie:
;;
;;   let mut keep_going: bool = true
;;   while keep_going is
;;       qt::process_events()
;;       let ev = qt::poll_event()
;;       if ev != nil is
;;           match ev.kind is
;;               qt::EventKind::Clicked      => is write("kliknięto!") end
;;               qt::EventKind::WindowClosed => is keep_going = false end
;;               _                           => is end
;;           end
;;       end
;;       keep_going = keep_going && qt::is_running()
;;   end
pub fn poll_event() -> Event? is
    let kind_raw: i32 = qth_poll_event()
    if kind_raw == 0 is
        return nil
    end
    return Event {
        kind:   event_kind_from_i32(kind_raw),
        widget: Widget { handle: qth_event_handle() },
    }
end

